# Hermes agent secrets — TEMPLATE. Real values are NEVER committed.
#
# SOURCE OF TRUTH: the file on the NAS (this template records only the shape).
# HOST PATH:       /volume1/docker/appdata/hermes-etc/hermes.env
# OWNER/MODE:      root:10 0640   (see appdata-templates/README.md)
# MOUNTED AS:      /opt/data/.env  READ-ONLY
#
# Owner root so the agent cannot rewrite it; group 10 because the container
# runs as user "1000:10", so GID 10 is the only group the agent process holds
# and therefore the only one that can grant it read access. Mode 0640 rather
# than 0644 keeps the secrets off the world-readable bit. NOTE: on the DSM
# host, GID 10 is `wheel` — administrators — so 0640 grants host-side read to
# admins, which sudo already grants anyway.
#
# Filled in by plan Task 6. Every value below is a PLACEHOLDER.

# Dashboard auth (spec §4.4 layer 5). Generate with:
#   openssl rand -base64 24   /   openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=<USERNAME>
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<GENERATED_PASSWORD>
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<GENERATED_HEX_SECRET>

# Dedicated OpenRouter key with a hard monthly credit cap (spec §4.7).
# Never reuse an existing key — this one lives on an internet-reachable agent
# and must be independently revocable.
OPENROUTER_API_KEY=<OPENROUTER_KEY>

# Fine-grained GitHub PAT, scoped to only the repos cloned into /volume1/code,
# Contents: read/write and nothing else. Never an account-wide classic token.
GITHUB_TOKEN=<FINE_GRAINED_PAT>

# One messaging channel at a time. The sender allowlist lives in config.yaml.
TELEGRAM_BOT_TOKEN=<BOTFATHER_TOKEN>
